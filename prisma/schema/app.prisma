// Fork-owned schema file — reserved for YOUR app's models.
//
// Sunrise ships this file empty and never adds models to it, the same way it
// keeps `lib/app/**` and `.context/app/` empty, so a fork's models here merge
// cleanly on every upstream sync. Sunrise's own app-domain models
// (ContactSubmission, FeatureFlag, AuthBootstrap) live in `platform.prisma`.
//
// The schema is multi-file (`prisma.config.ts` → `schema: 'prisma/schema'`), so
// every `.prisma` file in this folder is loaded — just add models below.
//
// See CUSTOMIZATION.md §5 for the FK/onDelete rules a model with a `userId`
// must follow (GDPR erasure depends on them).

/// Where a waitlist entry came from.
///
/// `form` is the public home page's card, and is the only value anything writes
/// today. `conversation` is reserved for the path the product description
/// describes — someone asking to be told when a place opens, in a conversation
/// with the agent — which has no code behind it yet. It is vocabulary rather
/// than a shipped write path, and it is here now because adding an enum value
/// later is a migration on a table that will by then hold real people.
enum AppWaitlistSource {
  form
  conversation

  @@map("app_waitlist_source")
}

/// Someone who asked to be told when a place opens.
///
/// The app is not open, so this is the only thing a visitor can actually do —
/// and what they said while doing it is the point, not a by-product. `intent`
/// ("what would you want to achieve") and `heardFrom` are read by Lelañea
/// herself while there are still few enough entries to read one by one, and
/// `intent` is meant to seed that person's profile if they later sign up, so
/// what someone said they wanted before signing up is not thrown away at the
/// point they do.
///
/// **`userId` is a plain scalar with no Prisma `@relation`** — a fork table must
/// not add a reverse field to the Sunrise-owned `User` model (CUSTOMIZATION.md
/// §5). The foreign key is hand-written in the `app_waitlist_entry` migration
/// with `ON DELETE SET NULL`, and pinned by a drift probe in
/// `lib/app/leaf-db-drift.ts` so a future `migrate dev` cannot quietly drop it.
///
/// `SET NULL` — not `Cascade` — because the row survives the account: the
/// waitlist is a record of who asked, and erasing an account should not silently
/// re-open a place. What it must NOT do is retain the person's email and their
/// answers, so the erasure hook registered from `lib/app/leaf-bootstrap.ts`
/// deletes the row outright inside the erasure transaction. The FK's `SET NULL`
/// is the backstop for a row the hook cannot match, not the policy.
model AppWaitlistEntry {
  id          String            @id @default(cuid())
  /// Lower-cased on write, which is what makes `@unique` mean one person.
  email       String            @unique
  name        String?
  /// "Where did you hear about this?" — optional (D2).
  heardFrom   String?
  /// "What would you want to achieve?" — optional (D2).
  intent      String?
  source      AppWaitlistSource @default(form)
  /// The language tag the joiner's browser asked for, so a later locale can
  /// tell who joined in which. Falls back to the authored collection's locale.
  locale      String
  /// When they submitted under the card's "used to tell you when a place opens,
  /// and for nothing else" notice. Server-set; there is no separate checkbox.
  consentedAt DateTime
  /// The account this entry became, once the person accepted an invitation.
  /// Written by the `user-created` hook in `lib/app/waitlist/service.ts`,
  /// matched on the lower-cased email, together with `joinedAt`. Hand-written
  /// FK — see the note above.
  userId      String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  /// When an admin took them off the list. Null means they are on it.
  ///
  /// **`removedAt`, not `deletedAt`, and the name is the point.** Nothing is
  /// deleted: the row survives holding this person's email, their name and what
  /// they said they wanted. Calling it a deletion is how a later reader concludes
  /// the Art. 17 duty was met by a click in the admin, which it was not — erasure
  /// still DELETES the row outright, through the hook registered from
  /// `lib/app/leaf-bootstrap.ts`, and the Art. 15 export still has to disclose a
  /// removed entry because we still hold it.
  removedAt         DateTime?
  /// When a removed address was last submitted through the public form again.
  ///
  /// A re-join does NOT put someone back on the list (D9, owner, 11 September
  /// 2026): nothing on that route proves the submitter owns the address, so
  /// clearing the removal would let anyone who knows an address undo someone
  /// else's removal. Recording the attempt is the middle path — the removal
  /// sticks, and a genuine "actually, please put me back" is visible to her
  /// rather than silently swallowed.
  rejoinRequestedAt DateTime?
  /// How many times a removed address has been submitted again. See above.
  rejoinRequests    Int       @default(0)
  /// When an admin last sent this person an invitation from the list. Moved on
  /// a resend — it records the latest send, and the CSV column is named for
  /// that. Null means nobody has invited them from here; an invitation raised
  /// from Sunrise's Admin → Users → Invite does not stamp it, and does not need
  /// to for `joinedAt` to land.
  invitedAt         DateTime?
  /// When the person accepted an invitation and got an account. Set with
  /// `userId`, by the hook. A joined entry is off the default list the way a
  /// removed one is, and for the opposite reason: not "will not be written
  /// to", but "already in". The two are different states — `removedAt` is left
  /// alone when someone joins — and the Art. 15 export discloses which.
  joinedAt          DateTime?

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
  @@index([createdAt])
  /// NO index on `removedAt`, deliberately. The hot predicate is `removedAt IS
  /// NULL`, which matches nearly every row, so Postgres will sequentially scan
  /// whatever is indexed; the one selective form — `IS NOT NULL`, for the
  /// "show removed" view — wants a partial index, which Prisma's schema cannot
  /// express. An earlier version of this model carried `@@index([removedAt])` with
  /// a comment claiming the list "filters on this", which confuses reading the
  /// column with needing an index for it. Caught in review; the index was dropped
  /// before the migration shipped.
  @@map("app_waitlist_entry")
}

/// What a person can acknowledge at the gate — one value per thing the Terms
/// require before the app opens.
///
/// `disclaimer` and `terms` are the two foundational documents that carry
/// `requiresAcknowledgement: true` in the authored collection; `age_18` is the
/// eighteen-plus confirmation the Terms require, captured at the gate rather
/// than in Sunrise's signup form (A7) so no platform form is edited. The
/// mapping from a kind to its document id lives in `lib/app/gateway/`, and a
/// test pins that every acknowledgement-required document has a kind here.
enum AppAcknowledgementKind {
  disclaimer
  terms
  age_18

  @@map("app_acknowledgement_kind")
}

/// One thing a person acknowledged: which kind, against which version, when.
///
/// The gate in front of the shell reads this table (§06). A kind is satisfied
/// only by a row carrying the CURRENT version — the foundational collection's
/// version for the two documents, a constant for the age rule — so a change to
/// either document re-gates by construction, and the old row stays as the
/// record of what was agreed before. **Insert-only**: nothing updates or deletes
/// a row except erasure, which is why there is no `updatedAt`. The unique index
/// is what makes a repeat acknowledgement idempotent rather than a duplicate.
///
/// **`userId` is a plain scalar with no Prisma `@relation`** — a fork table must
/// not add a reverse field to the Sunrise-owned `User` model (CUSTOMIZATION.md
/// §5). The foreign key is hand-written in the `app_acknowledgement` migration
/// with `ON DELETE CASCADE` — this is personal data and goes when the account
/// goes — and pinned by a drift probe in `lib/app/leaf-db-drift.ts` so a future
/// `migrate dev` cannot quietly drop it. Declared in full as a subject-data
/// source in `lib/app/leaf-data-export.ts`.
model AppAcknowledgement {
  id              String                 @id @default(cuid())
  /// Hand-written FK — see the note above.
  userId          String
  kind            AppAcknowledgementKind
  /// The version this acknowledgement was given against: the foundational
  /// collection's `version` for `disclaimer` and `terms`, the constant the
  /// gateway module exports for `age_18`.
  documentVersion String
  /// Server-set at insert; the client never supplies it.
  acknowledgedAt  DateTime               @default(now())

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Per org (t-116): a person in two orgs acknowledges in each.
  @@unique([orgId, userId, kind, documentVersion])
  @@index([orgId])
  @@index([userId])
  @@map("app_acknowledgement")
}

/// What one knowledge document is FOR, in the part that cannot be a tag.
///
/// Purpose and sensitivity are managed `KnowledgeTag` rows — that is what lets
/// them drive Sunrise's own tagging surfaces and its per-agent grant machinery.
/// The licensing note is free text about ONE document, and `KnowledgeTag` has no
/// per-document value column, so it has nowhere to live in the taxonomy without
/// minting a tag per note.
///
/// **And it cannot live in `AiKnowledgeDocument.metadata` either.** That column
/// is REPLACED wholesale by `lib/orchestration/knowledge/document-manager.ts` on
/// ingest, retry and re-chunk — a note an admin typed would disappear the first
/// time a document was re-processed, with no error and nothing in the log to
/// connect the loss to the cause. Hence a leaf table: `app_*`, ours, and outside
/// every write path the platform owns.
///
/// **`documentId` is a plain scalar with no Prisma `@relation`** — a fork table
/// must not add a reverse field to a Sunrise-owned model (CUSTOMIZATION.md §5),
/// and `AiKnowledgeDocument` lives in `prisma/schema/orchestration-knowledge.prisma`.
/// The foreign key is hand-written in the `app_knowledge_designation` migration
/// with `ON DELETE CASCADE` — the note is *about* the document and means nothing
/// without it — and pinned by a drift probe in `lib/app/leaf-db-drift.ts` so a
/// future `migrate dev` cannot quietly drop it.
///
/// Holds no personal data: every column is about a file she uploaded, not about
/// a person. Declared as an EXCLUSION with that reason in
/// `lib/app/leaf-data-export.ts`, which is what the Art. 15 bundle shows a data
/// subject verbatim.
///
/// The row is the document's designation, so `documentId` is the primary key:
/// one designation per document, and a re-designation is an update rather than a
/// second row. There is deliberately no history here — what a document is for is
/// current state, and the audit log already records who changed it.
model AppKnowledgeDesignation {
  /// Hand-written FK → `ai_knowledge_document`. See the note above.
  documentId   String   @id
  /// Free-text attribution / permission note: whose words these are, and on what
  /// terms we may use them. Null means nobody has said yet — which is different
  /// from "no restriction", and the admin surface says so.
  licensing    String?  @db.Text
  /// Who last set it, for the same reason the audit log exists. Deliberately NOT
  /// a relation and NOT a foreign key: it is an admin's id on an operational
  /// note, the row survives that admin's account, and a `user` FK here would
  /// make `eraseUser()` fail or silently rewrite the record of who designated
  /// what. Rendered as an id, resolved by the admin list when it can.
  designatedBy String?
  /// Set only on a document the knowledge mirror wrote, e.g.
  /// `foundational:the_mission` (f-content-seeds t-90). It names the app row the
  /// document mirrors, so an edit re-ingests the same document and a removed row
  /// deletes it. Null on everything an admin uploaded, which the mirror never
  /// touches. See `lib/app/content/knowledge-mirror.ts`.
  sourceKey    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Per org (t-116): each org mirrors the same documents under the same keys.
  @@unique([orgId, sourceKey])
  @@index([orgId])
  @@map("app_knowledge_designation")
}

/// One time somebody listened to the whole golden set through both arms.
///
/// Sunrise already has the harness — `AiDataset`, `AiEvaluationRun`,
/// `AiEvaluationCaseResult`, a worker that drains a run and judge agents to
/// score one — and none of it knows what an ARM is. A run records which agent
/// answered; it records nothing about which version of her voice that agent was
/// wearing at the time, and there is no free column on `AiEvaluationRun` to put
/// it in. So the two runs queued together, and what each was told, are recorded
/// here.
///
/// **Why it has to be stored rather than derived.** The obvious alternative is
/// to read the fingerprint version off the agent's profile whenever the surface
/// renders. That answer is right only until the core changes — after which every
/// historical run silently re-attributes itself to the new version, and the one
/// comparison this feature exists to make (v1.0's answers beside v1.1's) becomes
/// a comparison of v1.1 with itself. The whole point is that outputs stay
/// attached to the words that produced them.
///
/// Holds no personal data — a version string, a hash and a timestamp. The run it
/// points at carries the admin who queued it, which is Sunrise's record and not
/// duplicated here. Declared as an EXCLUSION with that reason in
/// `lib/app/leaf-data-export.ts`.
model AppVoiceComparison {
  id                 String   @id @default(cuid())
  /// The golden set's own version at queue time — `seed-data/drafted/lelanea_voice_golden_set.json`.
  ///
  /// Separate from any arm's `fingerprintVersion`, and the pair is what makes a
  /// result readable a month later: her voice and the questions it was heard
  /// through move independently, so "which answers am I looking at" needs both.
  goldenSetVersion   String
  /// The dataset hash pinned onto every arm's run at queue time.
  ///
  /// Sunrise's worker fails a run whose dataset changed after submission, so
  /// this is not a second guard — it is what lets the surface say WHY two
  /// comparisons are not comparable, instead of showing them side by side as
  /// though they were.
  datasetContentHash String
  createdAt          DateTime @default(now())

  arms AppVoiceComparisonArm[]

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([createdAt])
  @@map("app_voice_comparison")
}

/// One arm of a comparison: the agent that answered, and the prompt it was given.
///
/// `systemPrompt` is the composed prompt itself, not a hash of it. It is the
/// evidence: `fingerprintVersion` beside it is a claim, and a claim about which
/// version produced an answer is exactly the sort of thing that should be
/// checkable by reading rather than trusted. It also means the bare arm's
/// control prompt is on the screen next to the answers it produced, which is the
/// half of an A/B comparison people usually have to take on faith.
///
/// **`arm` is a String, not an enum.** Two values exist today (`fingerprint` and
/// `bare`) and `lib/app/voice/comparison.ts` owns the vocabulary. A third — her
/// agent with the profile detached, which isolates the fingerprint rather than
/// the whole prompt — is a change to that file and a re-queue, not a migration
/// on a table holding history. An enum would price the experiment at a schema
/// change.
///
/// **`evaluationRunId` is a plain scalar with no Prisma `@relation`** — a fork
/// table must not add a reverse field to a Sunrise-owned model
/// (CUSTOMIZATION.md §5). The foreign key is hand-written — created in the
/// `app_voice_comparison` migration, given its current delete action in
/// `app_voice_comparison_arm_run_set_null` — and pinned by a drift probe in
/// `lib/app/leaf-db-drift.ts` so a future `migrate dev` cannot quietly drop it.
/// The correction is a second migration rather than an edit to the first
/// because the first had already been applied, and a migration Prisma has
/// recorded is never re-run: editing it would have left every existing database
/// on the old action while failing its next `migrate deploy` on the checksum.
///
/// **`ON DELETE SET NULL`, not `CASCADE`, and the reason is the whole point of
/// this table.** `AiEvaluationRun.user` is `onDelete: Cascade`, so erasing the
/// admin who queued a comparison deletes their runs. Under `CASCADE` that took
/// this row with them — the stored prompt, the version, the record that the
/// check happened at all — and left an `AppVoiceComparison` the surface still
/// rendered with no arms and no explanation. The answers go either way, because
/// `AiEvaluationCaseResult` hangs off the run and is Sunrise's to cascade. What
/// must not go is the half this table exists for: nothing here is about the
/// admin, so their erasure has no business destroying it. Caught by
/// /code-review.
///
/// A null therefore means one specific thing — *the run that produced these
/// answers no longer exists* — and the surface says so rather than reporting
/// the case as not yet answered.
model AppVoiceComparisonArm {
  id                 String   @id @default(cuid())
  comparisonId       String
  /// `fingerprint` | `bare`. See the note above.
  arm                String
  /// The agent that answered this arm's cases, by slug.
  agentSlug          String
  /// Read back out of `systemPrompt` at queue time by `readFingerprintVersion()`.
  ///
  /// Null is the bare arm's honest answer rather than a missing value: a prompt
  /// with no version marker in it is a prompt that never carried her core. It is
  /// also the assertion the queue-time guard makes — a bare arm that came back
  /// with a version is a misconfiguration, and the run is refused rather than
  /// queued.
  fingerprintVersion String?
  /// What this arm was actually told, composed at queue time.
  systemPrompt       String   @db.Text
  /// Hand-written FK → `ai_evaluation_run`. Null once that run has been
  /// deleted — see the note above. `@unique` still holds: Postgres admits
  /// several nulls in a unique index, and `@@unique([comparisonId, arm])` is
  /// what actually keeps one row per arm.
  evaluationRunId    String?  @unique
  createdAt          DateTime @default(now())

  comparison AppVoiceComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  /// One row per arm per comparison — a second `bare` row would mean two runs
  /// claiming to be the same control, and the surface would pick one silently.

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, arm])
  @@index([orgId])
  @@index([comparisonId])
  @@map("app_voice_comparison_arm")
}

/// The agent's deadlines and the default monthly spending ceiling — one row,
/// operator-owned.
///
/// Owner ruling at claim (§08 t-53): no first words within 8 seconds and the app
/// speaks up; a turn ends at 60 seconds; $5 per user per month to start — and
/// all of it changeable by an admin, because with no revenue every conversation
/// is pure cost and the right numbers will be learned from use. A constant that
/// needs a deploy to change is the wrong shape for that.
///
/// **Created once, by the migration that creates the table** — an `INSERT` of the
/// ruled defaults — and never written again by a seed or a boot (`fp4`). From
/// then on the only writer is the admin surface. `lib/app/agent/settings.ts`
/// holds the same three numbers as constants for one purpose only: answering if
/// the row is somehow missing, and a test holds the migration's values to them.
///
/// **This row enforces nothing.** It is read per request by the resolvers in
/// `lib/app/agent/settings.ts`; §08 t-55 applies the deadlines, f-safety acts on
/// a ceiling being reached, f-budget shows it. See `.context/app/agent.md`.
///
/// Holds nothing about anyone — who changed it is recorded in the admin audit
/// log, not here. Declared as an EXCLUSION in `lib/app/leaf-data-export.ts`.
model AppAgentSettings {
  /// Always `global`. A string key rather than a bare boolean so the singleton is
  /// addressable by name, the way `AiOrchestrationSettings` is.
  id                       String   @id @default(cuid())
  slug                     String   @default("global")
  /// How long a turn may go without its first words before the app says so.
  firstWordsDeadlineMs     Int
  /// How long a whole turn may run before it is ended.
  turnDeadlineMs           Int
  /// What one person may spend in a calendar month, in USD, unless they carry
  /// an override (`AppUserBudget`).
  defaultMonthlyCeilingUsd Float
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("app_agent_settings")
}

/// One person's monthly spending ceiling, where it differs from the default.
///
/// **No row means the default applies.** Clearing an override deletes the row;
/// it is never set to zero, because zero is a real answer ("this person may spend
/// nothing") and must stay distinguishable from "no answer".
///
/// **`userId` is a plain scalar with no Prisma `@relation`** — a fork table must
/// not add a reverse field to the Sunrise-owned `User` model (CUSTOMIZATION.md
/// §5). The foreign key is hand-written in the `app_agent_settings` migration
/// with `ON DELETE CASCADE` — a ceiling set for a person is about that person
/// and goes with the account — and pinned by a drift probe in
/// `lib/app/leaf-db-drift.ts`. Declared as a subject-data source in
/// `lib/app/leaf-data-export.ts`.
model AppUserBudget {
  id                String   @id @default(cuid())
  /// Hand-written FK → `user`. See the note above. One override per person per
  /// org (t-114): unique with `orgId`, so a person in two orgs has one in each.
  userId            String
  monthlyCeilingUsd Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  /// A person's budgets across orgs, and the user FK's cascade on erasure.
  @@index([userId])
  @@index([orgId])
  @@map("app_user_budget")
}

/// Where a turn stands. A claim is `running` from before the model is called
/// until the stream ends; see `lib/app/agent/turns.ts` for what each state lets a
/// second request with the same id do.
enum AppTurnStatus {
  running
  completed
  failed

  @@map("app_turn_status")
}

/// Whether the turn's cost could be known.
///
/// `unpriced` is the reason this column exists: Sunrise prices a turn from an
/// in-memory registry, and a model outside it is logged at $0 with a warning
/// nobody reads. That is not the same fact as `local` — a model on a provider
/// marked local, which really is free — and a meter that stored both as `0`
/// could not tell a free turn from one nobody knows the price of.
enum AppTurnPricing {
  priced
  unpriced
  local

  @@map("app_turn_pricing")
}

/// One turn with the agent: what was asked for, and what produced the answer.
///
/// §8.1 (a turn sent twice is one turn) and §8.2 (every turn records which model
/// and which prompt produced it). The platform records the model and provider on
/// the assistant message and nothing else: it sets no agent version on a
/// streaming turn, Lelañea Fulton's voice lives in a profile the agent snapshot does not
/// cover, and a cost row knows the person but not the seat. This row is the
/// record that joins them, keyed on the turn id.
///
/// **Holds no words.** The person's message and the reply are Sunrise's
/// `ai_message` rows; this points at them by id (`userMessageId`,
/// `assistantMessageId`) and a replay reads the reply from there. Copying the
/// text here would be a second copy of the conversation with its own erasure
/// and export story.
///
/// **The message ids are plain scalars with no foreign key**, deliberately. A
/// person deleting a conversation deletes its messages; the turn — what model,
/// what version, what it cost — survives that as metering, and a replay of a
/// turn whose reply is gone says so rather than inventing one.
///
/// **`userId` is a plain scalar with no Prisma `@relation`** — a fork table must
/// not add a reverse field to the Sunrise-owned `User` model (CUSTOMIZATION.md
/// §5). The FK is hand-written in the `app_turn` migration with `ON DELETE
/// CASCADE` — a turn is about the person who took it — and pinned by a drift
/// probe in `lib/app/leaf-db-drift.ts`. Declared as a subject-data source in
/// `lib/app/leaf-data-export.ts`.
model AppTurn {
  id                 String          @id @default(cuid())
  /// Hand-written FK → `user`. See the note above.
  userId             String
  /// The client's id for the turn, or one minted here when the client sent none.
  /// Unique per person, never globally: one person's id can neither collide with
  /// nor reveal another's.
  turnId             String
  /// Whether `turnId` came from the client. A minted id can never be sent again,
  /// so only a client id can replay — which is how a turn with no id behaves
  /// exactly as it did before turn ids existed.
  clientSupplied     Boolean
  /// SHA-256 of the seat and the message. A repeat of the same id must be the
  /// same request: an id reused for different words is a client bug, and
  /// answering it with the first turn's reply would be wrong silently. Holds a
  /// digest, never the words.
  requestHash        String
  /// The facilitation seat the turn was taken in (`onboarding`, `facilitator`).
  seat               String
  agentSlug          String
  status             AppTurnStatus   @default(running)
  /// How many times this id has been claimed. A failed turn run again under the
  /// same id bumps it; a replay does not.
  attempts           Int             @default(1)
  /// Her voice fingerprint version, read from the agent's composed prompt at claim —
  /// null when the prompt carries no marker, which is the honest answer for an
  /// agent that does not inherit her core.
  fingerprintVersion String?
  /// Guiding or teaching: the register the turn was steered to, decided at
  /// claim (f-registers t-125). Null on a seat with no register, and on a turn
  /// claimed before registers existed. The prompt reads it back from here.
  register           String?
  /// Why: `module` (the person's current module's config) or `safety` (a
  /// crisis on this turn or within the hold).
  registerSource     String?
  /// The person's leanings the turn applied, and any held at rest because
  /// something hard is here (f-leanings t-136): `leaningsStampSchema` in
  /// `lib/app/voice/leanings-select.ts`. Decided at claim beside the register;
  /// the prompt reads it back from here. Null on a seat with no leanings, and on
  /// a turn claimed before them.
  leanings           Json?
  /// The session the turn fell in (f-recap t-141): the id of its
  /// `session.started` row in Daybreak's `framework_journey_event`, stamped at
  /// claim (`lib/app/sessions/store.ts`). What makes "which exchanges belong to
  /// a session" a lookup rather than a re-derivation from timestamps. Hand-written
  /// FK, `ON DELETE SET NULL`, with no Prisma `@relation`: a relation would add
  /// a reverse field to Daybreak's `JourneyEvent`. Null on every turn from before
  /// sessions, deliberately not backfilled: those sittings were never recorded.
  sessionId          String?
  /// What a session recap drew on (f-recap t-142): counts and note headings,
  /// never the material — `recapAccountSchema` in
  /// `lib/app/conversation/recap-account.ts`. Written when the recap is
  /// claimed; the account under the reply reads it back. Null on every other turn.
  recap              Json?
  conversationId     String?
  userMessageId      String?
  assistantMessageId String?
  /// What the platform reported on the turn's `done` event. Named as
  /// `AiMessage` names them — and not `model`, which a line-based scan of this
  /// file reads as a declaration.
  modelId            String?
  providerSlug       String?
  inputTokens        Int?
  outputTokens       Int?
  /// The chat cost the platform reported. **Null when `pricing` is `unpriced`**,
  /// never zero: zero would read as a free turn.
  costUsd            Float?
  pricing            AppTurnPricing?
  /// The error code the stream ended on, when it failed.
  errorCode          String?
  startedAt          DateTime        @default(now())
  completedAt        DateTime?

  /// Which slots this turn has already written — the retry guard (t-72).
  slotWrites AppTurnSlotWrite[]

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, turnId])
  @@index([orgId])
  @@index([userId, startedAt])
  @@index([conversationId])
  @@index([sessionId])
  /// The status read: the most recent turn anyone finished (§08 t-55).
  @@index([completedAt])
  @@map("app_turn")
}

/// One slot this turn has already written — so re-running the turn cannot write
/// it a second time (f-slots t-72; product description §8.1).
///
/// **What goes wrong without it.** A turn that fails after its tool calls is
/// settled `failed`, and the same id may run again (`turn-record.ts`). The
/// second run calls the model from scratch, the model reaches the same
/// conclusion about the same words, and `fill_slot` appends a SECOND version —
/// `framework_slot_value` is insert-only and has no turn-scoped idempotency key
/// of its own, so nothing below this stops it. The person said one thing once
/// and their profile records them saying it twice, with two timestamps. §8.1
/// says a retried turn cannot double-write the profile.
///
/// **The unique index is the guard, not a read-then-write.** Same shape as the
/// turn claim one table up: `@@unique([turnId, slotSlug])` is what makes "this
/// turn has already written this slot" a fact two concurrent dispatches cannot
/// both miss. `version` is kept so the suppressed call can answer the model with
/// the version that WAS written rather than an error — the reading is recorded,
/// which is what the tool was asked to achieve.
///
/// **A child of `AppTurn`, keyed on its `id` and not on `(userId, turnId)`.**
/// The turn row already carries the person, already has `ON DELETE CASCADE` to
/// `user`, and is already declared as a subject-data source — so this table's
/// Art. 17 disposition is the turn's, with no second hand-written FK to `user`
/// and no second erasure story to keep in step. A row cannot outlive the turn it
/// describes, and cannot describe a turn that is not this person's.
///
/// It is a **ledger of writes, not the writes themselves.** What was learned
/// lives in `framework_slot_value`, which the framework tier declares; this says
/// only that a write happened, so it is an exclusion in
/// `lib/app/leaf-data-export.ts` rather than a source.
model AppTurnSlotWrite {
  id        String   @id @default(cuid())
  turnId    String
  turn      AppTurn  @relation(fields: [turnId], references: [id], onDelete: Cascade)
  /// The slot the turn filled. Not an FK: an open-mode mint has no definition
  /// row, for the same reason `framework_slot_value.slotSlug` is not one.
  slotSlug  String
  /// The version `fill_slot` wrote, so a suppressed retry answers with it.
  version   Int
  /// Whether that write minted a new slug rather than filling an authored slot.
  minted    Boolean
  writtenAt DateTime @default(now())

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([turnId, slotSlug])
  @@index([orgId])
  @@map("app_turn_slot_write")
}

/// What a memory embedding was made from (f-memory t-129). One value per
/// source kind, each with its own cascading foreign key column on the row:
/// `message` (a person's own message, `messageId`, t-129) and `note` (the head
/// version of one of their notes, `slotValueId`, t-107).
enum AppMemorySourceKind {
  message
  note
  /// A kept synopsis in the journey record (f-journey-record t-149).
  synopsis
  /// Something the person wrote in their journey themselves (t-149).
  own_entry

  @@map("app_memory_source_kind")
}

/// One thing a person said, or one note the app keeps about them, embedded so
/// it can be found again by meaning, for that person only (f-memory t-129,
/// t-107; product description §5, §3.19).
///
/// **A leaf stand-in for daybreak#287** (owner ruling 1, 3 Oct 2026). Only
/// `lib/app/memory/memory-index.ts` reads or writes this table
/// (`tests/unit/lib/app/memory/index-boundary.test.ts`), so swapping it for
/// Daybreak's index is a change to one module.
///
/// **Holds no words.** The text stays in its source (`ai_message.content`,
/// `framework_slot_value.value`) and a search reads it from there. A copy here would be a second copy of the
/// conversation with its own deletion story.
///
/// **An embedding goes with its source** (owner ruling 2, at claim).
/// Hand-written FKs, all `ON DELETE CASCADE`, none modelled by Prisma: a fork
/// table must not add a reverse field to a Sunrise model (CUSTOMIZATION.md §5).
/// They are `userId` → `user` (erasure), `messageId` → `ai_message` (deleting a
/// message, an exchange or a conversation), `slotValueId` →
/// `framework_slot_value` (t-107), and the org relation below. The
/// migration's CHECK ties `sourceKind` to its column. Each is pinned by a drift
/// probe in `lib/app/leaf-db-drift.ts`, as is the hand-written HNSW index.
///
/// **A note's vector is not always taken by a cascade.** Removing a note and
/// deleting the exchange that wrote it rewrite versions in place rather than
/// deleting them (`lib/app/slots/wipe.ts`), so each drops the vectors of the
/// versions it wipes, in the same transaction (`forgetWipedNotes`).
model AppMemoryEmbedding {
  id                 String                      @id @default(cuid())
  /// Hand-written FK → `user`, `ON DELETE CASCADE`. The person the words are
  /// theirs; every search filters on it.
  userId             String
  sourceKind         AppMemorySourceKind
  /// Hand-written FK → `ai_message`, `ON DELETE CASCADE`. Set when
  /// `sourceKind` is `message`; one embedding per message.
  messageId          String?                     @unique
  /// Hand-written FK → `framework_slot_value`, `ON DELETE CASCADE`. Set when
  /// `sourceKind` is `note`; one embedding per version, and only the head
  /// version keeps one (t-107).
  slotValueId        String?                     @unique
  /// Set when `sourceKind` is `synopsis` or `own_entry` (t-149): a kept entry
  /// of the journey record the person has not kept from her. Both tables are
  /// ours, so this one is modelled. Removing the entry, or erasure, takes it.
  journeyEntryId     String?                     @unique
  journeyEntry       AppJourneyEntry?            @relation(fields: [journeyEntryId], references: [id], onDelete: Cascade)
  embedding          Unsupported("vector(1536)")
  /// The model that made the vector. A search compares only vectors made by
  /// the model that embedded the query: two models' vectors are not comparable.
  embeddingModel     String
  embeddingProvider  String
  embeddingDimension Int
  createdAt          DateTime                    @default(now())

  /// The org this row belongs to (Sunrise §107, t-112), taken from the source row.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId, embeddingModel])
  @@index([orgId])
  @@map("app_memory_embedding")
}

/// Which of the two things fill the journey record (f-journey-record t-145,
/// product description §3.16). Module reflections, the third, land from phase 7
/// and add a value here then.
enum AppJourneyEntryKind {
  /// The app's account of one session, drafted by the synopsis seat (t-146).
  synopsis
  /// Something the person wrote themselves, whenever they wanted.
  own

  @@map("app_journey_entry_kind")
}

/// Whether an entry is in the record yet. Nothing enters it over the person's
/// head (§12): a synopsis is a `draft` until they approve, edit or regenerate
/// it (t-147), and only then `kept`. An own entry is `kept` from the moment it
/// is written, because the person wrote it.
enum AppJourneyEntryState {
  draft
  kept

  @@map("app_journey_entry_state")
}

/// What keeping still owes a synopsis's notes (t-147): confirming the ticked
/// ones, or reading the kept text against them first. Null once settled.
enum AppJourneyNotesPending {
  confirm
  reread

  @@map("app_journey_notes_pending")
}

/// One entry in a person's journey record (f-journey-record t-145; product
/// description §3.16): a session's synopsis, or something they wrote.
///
/// **Ours, not Daybreak's event stream** (owner ruling, 6 Oct 2026, at
/// planning). `framework_journey_event` is insert-only by contract, and this
/// record is not: a draft is replaced, a kept entry is edited, and §12 says
/// anything in it can be removed, which must remove the words rather than
/// append a tombstone beside them. Ledgered in `.context/app/divergences.md`
/// (Row 29), with daybreak#293 proposing the element this stands in for.
///
/// **Only `lib/app/journey-record/` reads or writes it.**
///
/// Hand-written FKs, neither modelled by Prisma (a relation would add a reverse
/// field to a model we do not own), each pinned by a drift probe in
/// `lib/app/leaf-db-drift.ts`:
/// - `userId` → `user`, `ON DELETE CASCADE`: the record is the person's.
/// - `sessionId` → `framework_journey_event` (the session's `session.started`
///   row), `ON DELETE CASCADE`: a synopsis is about its session and goes with
///   it. Unlike `app_turn`'s metering, which outlives the session row
///   (`SET NULL`), nothing of a synopsis is worth keeping once the session it
///   describes has been forgotten (f-forget-session).
///
/// The migration's CHECK ties `kind` to `sessionId`: a synopsis names its
/// session, and an own entry names none. The unique index on `sessionId`
/// gives a session one synopsis, whichever state it is in, so a redraft
/// replaces the draft rather than adding a second.
model AppJourneyEntry {
  id                String                  @id @default(cuid())
  /// Hand-written FK → `user`. See the note above.
  userId            String
  kind              AppJourneyEntryKind
  state             AppJourneyEntryState
  /// Hand-written FK → the session's `session.started` row. Set for a
  /// synopsis, null for an own entry.
  sessionId         String?                 @unique
  /// The one line a stop shows when it is closed. Required of a synopsis; an
  /// own entry may have none.
  summary           String?
  /// A synopsis's account, in her voice, of what was actually said; or the
  /// words of an own entry.
  body              String
  /// What came of a session: `journeyOutcomesSchema` in
  /// `lib/app/journey-record/entry.ts`, each an action, an insight or a
  /// tension. Empty on an own entry.
  outcomes          Json                    @default("[]")
  /// The slugs of the modules a session touched. Empty when it touched none,
  /// which in release 1, before modules have interiors, is the usual case.
  modules           String[]                @default([])
  /// The visible notes a session's turns wrote, each `{ slotSlug, version }`
  /// (`journeyNoteRefsSchema` in `lib/app/journey-record/entry.ts`), listed so
  /// keeping the synopsis can confirm them (owner ruling 2). References only,
  /// never a reading: the words stay in the note, where removing it takes them.
  /// Hidden and special-category notes are never listed. Empty on an own entry.
  notes             Json                    @default("[]")
  /// "Keep this from her": the person has asked that no agent read this entry
  /// (owner ruling 4, at planning). Drafts are never read whatever this says.
  withheldFromAgent Boolean                 @default(false)
  /// Where the entry sits in time: a synopsis at its session's start, an own
  /// entry when it was written. The record is ordered on it, newest first.
  occurredAt        DateTime
  /// When the entry was kept. Null while it is a draft.
  keptAt            DateTime?
  /// How many times the person has asked for another draft of this synopsis
  /// (t-147). Capped (`MAX_SYNOPSIS_REGENERATIONS`), and claimed before the
  /// model is called, so a double submit drafts once.
  regenerations     Int                     @default(0)
  /// Set when an exchange this synopsis was written from has since been
  /// deleted (owner ruling, 6 Oct 2026, at t-147). Only a kept synopsis is
  /// flagged: a draft is removed instead. Cleared when the person changes it.
  sourceRemovedAt   DateTime?
  /// What keeping still owes its notes (t-147). Set by the write that keeps
  /// it and cleared once the notes are settled, so a keep that failed half
  /// way is finished by the next one, never forgotten.
  notesPending      AppJourneyNotesPending?
  /// A keep or a redraft is under way (t-147): the lease that makes a second
  /// submit wait rather than race. Taken over once older than the lease.
  workingSince      DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Its vector in the memory index, while it is kept and not kept from her (t-149).
  memoryEmbedding AppMemoryEmbedding?

  @@index([userId, occurredAt])
  @@index([orgId])
  @@map("app_journey_entry")
}

