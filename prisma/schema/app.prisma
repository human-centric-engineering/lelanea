  collectionSlug   String
  collectionId     String
  collection       AppResourceCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  quote            String
  paragraphs       String[]
  /// `foundational_documents` | `values_module`.
  sourceCollection String
  /// The document id or values step id the passage is taken from.
  sourceId         String
  revision         Int                   @default(1)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  revisions AppResourceWordsRevision[]

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@index([orgId])
  @@map("app_resource_words")
}

/// One revision of one key's words, whole (t-87).
model AppResourceWordsRevision {
  id               String                   @id @default(cuid())
  wordsKey         String
  wordsId          String
  words            AppResourceWords         @relation(fields: [wordsId], references: [id], onDelete: Cascade)
  revision         Int
  quote            String
  paragraphs       String[]
  sourceCollection String
  sourceId         String
  changedFields    String[]
  origin           AppContentRevisionOrigin
  editorId         String?
  changedAt        DateTime                 @default(now())

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([wordsId, revision])
  @@index([orgId])
  @@index([wordsId, changedAt])
  @@index([editorId])
  @@map("app_resource_words_revision")
}

/// Whether she has signed a piece of the voice fingerprint off (t-88).
///
/// The same two states as `app_crisis_content_status` and deliberately a
/// separate enum: the crisis copy and her register are different material,
/// signed off by different people at different moments, and sharing one enum
/// would couple a change to either.
enum AppVoiceContentStatus {
  draft
  signed_off

  @@map("app_voice_content_status")
}

/// The context-selected layer of the voice fingerprint as a whole (t-88): its
/// identity, its provenance, and the two authored blocks that are not tied to
/// any one situation. One row.
///
/// `exemplars` and `coreOnly` live here rather than on an overlay because
/// neither belongs to a situation: `coreOnly` is the body used when no overlay
/// matched, and `exemplars` is the copy that labels a retrieved passage as
/// hers. Every string in both reaches a model, and `exemplars.originLabel` is
/// the load-bearing one — it is what tells the model her writing from the
/// person's.
///
/// `provenance` is the authored block (`status`, `awaitingSignOffFrom`,
/// `note`), kept whole because it is shown to a reader as written. The
/// `status` column beside it is the operator's sign-off and is what code
/// branches on; the two answer different questions and neither is derived from
/// the other.
model AppVoiceOverlaySet {
  id          String                @id @default(cuid())
  /// Stable identity, as authored: `lelanea_voice_fingerprint_overlays`.
  slug        String
  title       String
  version     String
  locale      String
  /// `{ status, awaitingSignOffFrom, note }`, as authored.
  provenance  Json
  /// `{ heading, originLabel, lines, noneFoundNote, unavailableNote }`.
  exemplars   Json
  /// `{ heading, lines }` — the body used when no overlay matched.
  coreOnly    Json
  /// The leaning bounds (f-leanings t-135, owner ruling 2): per dial, the
  /// furthest stop each way and whether the AI may suggest moving it.
  /// `leaningBoundsSchema` in `lib/app/voice/leanings.ts`.
  leanings    Json
  status      AppVoiceContentStatus @default(draft)
  signedOffAt DateTime?
  revision    Int                   @default(1)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  overlays  AppVoiceOverlay[]
  revisions AppVoiceOverlaySetRevision[]

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("app_voice_overlay_set")
}

/// One revision of the set's framing, whole (t-88).
model AppVoiceOverlaySetRevision {
  id            String                   @id @default(cuid())
  setSlug       String
  setId         String
  set           AppVoiceOverlaySet       @relation(fields: [setId], references: [id], onDelete: Cascade)
  revision      Int
  title         String
  version       String
  locale        String
  provenance    Json
  exemplars     Json
  coreOnly      Json
  /// The leaning bounds as they stood (t-135). Null on a revision written
  /// before the set had them: a restore of one keeps the bounds it finds.
  leanings      Json?
  status        AppVoiceContentStatus
  changedFields String[]
  origin        AppContentRevisionOrigin
  editorId      String?
  changedAt     DateTime                 @default(now())

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([setId, revision])
  @@index([orgId])
  @@index([setId, changedAt])
  @@index([editorId])
  @@map("app_voice_overlay_set_revision")
}

/// One register overlay (t-88): the situation it answers to, and the beats it
/// adds to the always-on core.
///
/// `situation` is the primary key because it is also the wire vocabulary — a
/// chat request carries it as its `contextId` — so there is no second
/// identifier to keep in step with it. Selection is an exact match on this
/// column and nothing else.
///
/// `reviewerNote` is the file's `when`: a note to whoever reviews these, served
/// to a reviewer and emitted to no prompt. It is named for what it is here
/// because `when` is a reserved word in SQL.
model AppVoiceOverlay {
  id            String                @id @default(cuid())
  /// The authored situation key, e.g. `first-meeting`.
  situation     String
  setSlug       String
  setId         String
  set           AppVoiceOverlaySet    @relation(fields: [setId], references: [id], onDelete: Cascade)
  /// 1-based, and the order they were authored in.
  position      Int
  label         String
  /// The file's `when`. Never reaches a prompt.
  reviewerNote  String
  heading       String
  /// Each entry is a beat. Joined with a newline, never with a space.
  lines         String[]
  /// What her voice material is searched for in this moment. Authored.
  exemplarQuery String
  status        AppVoiceContentStatus @default(draft)
  signedOffAt   DateTime?
  revision      Int                   @default(1)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  revisions AppVoiceOverlayRevision[]

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([setId, position])
  @@unique([orgId, situation])
  @@index([orgId])
  @@map("app_voice_overlay")
}

/// One revision of one overlay, whole (t-88).
model AppVoiceOverlayRevision {
  id            String                   @id @default(cuid())
  situation     String
  overlayId     String
  overlay       AppVoiceOverlay          @relation(fields: [overlayId], references: [id], onDelete: Cascade)
  revision      Int
  position      Int
  label         String
  reviewerNote  String
  heading       String
  lines         String[]
  exemplarQuery String
  status        AppVoiceContentStatus
  changedFields String[]
  origin        AppContentRevisionOrigin
  editorId      String?
  changedAt     DateTime                 @default(now())

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([overlayId, revision])
  @@index([orgId])
  @@index([overlayId, changedAt])
  @@index([editorId])
  @@map("app_voice_overlay_revision")
}

/// Which golden set is the current one, and whether she has signed it off
/// (t-88). One row.
///
/// **It holds only what the dataset does not** (`fp4`, one owner per field).
/// The prompts themselves live in the platform's `AiDataset` / `AiDatasetCase`,
/// written by `prisma/seeds/app-lelanea/004-voice-golden-set.ts`, and the
/// control's system instructions live on the control agent, reconciled by the
/// same seed. Copying either here would be the two-writable-copies failure
/// t-87 named; what was genuinely missing is the two things below.
///
/// `version` is the POINTER: a dataset's id is `lelanea-voice-golden-set-v` +
/// this value, so this row is what decides which set a comparison runs and
/// which one the admin page shows. Before t-88 the authored file decided it,
/// which is why nothing in the database could answer the question.
///
/// `provenance` is the authored block, shown to whoever reads the set. The
/// `status` column beside it is the operator's sign-off; the two answer
/// different questions, exactly as on `app_voice_overlay_set`.
model AppVoiceGoldenSet {
  id          String                @id @default(cuid())
  /// Stable identity, as authored: `lelanea_voice_golden_set`.
  slug        String
  title       String
  /// The authored version, and the suffix of the dataset id it points at.
  version     String
  locale      String
  /// `{ status, awaitingSignOffFrom, note }`, as authored.
  provenance  Json
  status      AppVoiceContentStatus @default(draft)
  signedOffAt DateTime?
  revision    Int                   @default(1)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  revisions AppVoiceGoldenSetRevision[]

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("app_voice_golden_set")
}

/// One revision of the golden set's pointer and provenance, whole (t-88).
model AppVoiceGoldenSetRevision {
  id            String                   @id @default(cuid())
  setSlug       String
  setId         String
  set           AppVoiceGoldenSet        @relation(fields: [setId], references: [id], onDelete: Cascade)
  revision      Int
  title         String
  version       String
  locale        String
  provenance    Json
  status        AppVoiceContentStatus
  changedFields String[]
  origin        AppContentRevisionOrigin
  editorId      String?
  changedAt     DateTime                 @default(now())

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([setId, revision])
  @@index([orgId])
  @@index([setId, changedAt])
  @@index([editorId])
  @@map("app_voice_golden_set_revision")
}
