  @@map("app_slot_definition")
}

/// One version of one slot definition — the whole wording as it stood, not a
/// diff (f-slots t-70).
///
/// **A full snapshot, on purpose.** The question this table exists to answer is
/// "what did this slot mean when that answer was given?", which is a read at a
/// timestamp: the newest revision whose `changedAt` is at or before the capture.
/// A chain of diffs would make that a replay. `changedFields` carries the "what
/// changed" on top of the snapshot, for the editor's history view.
///
/// `version` 1 is the creation — every field is in `changedFields`, because
/// against nothing, everything is new.
///
/// **`editorId` is a plain scalar with no Prisma `@relation`** — a fork table
/// must not add a reverse field to the Sunrise-owned `User` model
/// (CUSTOMIZATION.md §5). The foreign key is hand-written in the
/// `app_slot_taxonomy` migration with `ON DELETE SET NULL`, and pinned by a
/// drift probe in `lib/app/leaf-db-drift.ts`.
///
/// `SET NULL` — not `Cascade` — because the history is about the taxonomy, not
/// about the editor. Erasing an admin's account must remove their identity from
/// this record; it must not remove the record that the wording changed, which is
/// what every captured value dated after it is read against. `origin` survives
/// the null, so a row left by an erased admin still reads as an admin edit
/// rather than as the seed.
model AppSlotDefinitionRevision {
  id             String                @id @default(cuid())
  slotSlug       String
  definitionId   String
  definition     AppSlotDefinition     @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  /// The version this revision produced. 1 is the creation.
  version        Int
  /// The definition's fields as they stood at this version.
  group          String
  description    String
  visibility     String
  mode           String
  dataType       String
  sensitivity    String
  priorityWeight Int
  isActive       Boolean
  /// Which of the snapshot fields differ from the previous revision. Every one
  /// of them at version 1. Empty is never written — an edit that changed
  /// nothing does not make a revision.
  changedFields  String[]
  origin         AppSlotRevisionOrigin
  /// The admin who made the edit; null for the seed, and null once that admin's
  /// account is erased. Read `origin` to tell those apart.
  editorId       String?
  changedAt      DateTime              @default(now())

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([definitionId, version])
  @@index([orgId])
  /// The "wording at time T" read: newest revision for a slug at or before T.
  @@index([slotSlug, changedAt])
  @@index([editorId])
  @@map("app_slot_definition_revision")
}

/// Who made one revision of an authored content row (f-content-seeds t-86).
///
/// `seed` is the one-time load from `content/`; `admin` is a person editing in
/// the admin (t-91). Named for content in general rather than for documents,
/// because the journey text, questions and resources (t-87) keep the same
/// history. It is a separate enum from `AppSlotRevisionOrigin` for the same
/// reason: that one belongs to the slot taxonomy. Like that one, it exists so
/// the seed can be told apart from an erased admin, since both leave
/// `editorId` null.
enum AppContentRevisionOrigin {
  seed
  admin

  @@map("app_content_revision_origin")
}

/// The collection her foundational documents belong to (f-content-seeds t-86).
/// There is one row, `lelanea_app_foundational_documents`.
///
/// It holds the identity, version and locale the content API reports as
/// `collection`, and the locale the waitlist falls back to. **The acknowledgement
/// gate does not read `version` here.** It reads each document's own version (see
/// `AppFoundationalDocument.version`), so a change to the mission cannot re-gate
/// anyone.
///
/// Holds nothing about any person; an EXCLUSION in `lib/app/leaf-data-export.ts`.
model AppDocumentCollection {
  id        String   @id @default(cuid())
  /// Stable identity, as authored in `content/lelanea_foundational_documents.json`.
  slug      String
  title     String
  /// The collection's authored version label, e.g. `1.1`.
  version   String
  /// BCP 47, as authored — `en-US`.
  locale    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents AppFoundationalDocument[]

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("app_document_collection")
}

/// One of her seven foundational documents, as the app currently serves it
/// (f-content-seeds t-86).
///
/// **This row is what every surface reads**: the public pages, the
/// acknowledgement gate, the welcome and waitlist emails, and
/// `/api/v1/app/content/documents*`. The file in `content/` only seeds it. Every
/// write goes through `lib/app/content/document-store.ts`, which is also where
/// the knowledge-base mirror (t-90) and the admin editor (t-91) attach.
///
/// **Operator-owned** (`fp4`). The seed writes it once and never again, so an
/// admin edit survives every later seed.
///
/// `blocks` is an ordered JSON array of heading, paragraph and list blocks, each
/// with a nullable `section` key. It is validated on every write and every read
/// against `storedDocumentBlocksSchema` in `lib/app/content/schemas.ts`. It is
/// JSON rather than a block table because every read and every revision takes the
/// document whole, and a snapshot of one column is a snapshot of the document.
///
/// **Two versions, for different jobs.** `version` is the label a person
/// acknowledges: the gate requires an `app_acknowledgement` row carrying exactly
/// this string. `revision` counts every write. A typo fix bumps `revision`
/// without re-gating anyone; a change people must agree to again also changes
/// `version`. That is a decision for whoever edits (t-91), not something inferred.
///
/// Holds nothing about any person; an EXCLUSION in `lib/app/leaf-data-export.ts`.
model AppFoundationalDocument {
  id                      String                @id @default(cuid())
  /// Stable identity, e.g. `terms_of_use`. Immutable: it is the API path segment
  /// and the key `DOCUMENT_FOR_KIND` maps an acknowledgement kind to.
  slug                    String
  collectionSlug          String
  collectionId            String
  collection              AppDocumentCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  /// Reading order within the collection — the authored `suggestedOrder`.
  position                Int
  title                   String
  subtitle                String?
  /// `onboarding` | `about` | `legal`. Validated on write and read.
  category                String
  /// Which app surface shows this document, e.g. `first_run_welcome`.
  surface                 String
  requiresAcknowledgement Boolean               @default(false)
  /// Merge fields present in the copy, e.g. `{{first_name}}`.
  placeholders            String[]
  /// `cadence` on the welcome statement: render each beat on its own line.
  renderStyle             String?
  renderNote              String?
  blocks                  Json
  /// The label an acknowledgement is recorded against. See the docblock.
  version                 String
  /// BCP 47, as authored.
  locale                  String
  /// Bumped on every write that changes something. 1 is the seed.
  revision                Int                   @default(1)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  revisions AppFoundationalDocumentRevision[]
  /// Resources that are this document, read in the app (t-87).
  resources AppResource[]

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([collectionId, position])
  @@unique([orgId, slug])
  @@index([orgId])
  @@map("app_foundational_document")
}

/// One revision of one foundational document: the whole document as it stood,
/// not a diff (f-content-seeds t-86).
///
/// Written from the first write, including the seed's, so the admin editor
/// (t-91) never has to reconstruct history. Same shape and reasoning as
/// `AppSlotDefinitionRevision`: a full snapshot makes "what did the Terms say on
/// the day this person agreed?" one read at a timestamp, rather than a replay.
///
/// **`editorId` is a plain scalar with no Prisma `@relation`**, because a fork
/// table must not add a reverse field to the Sunrise-owned `User` model. The
/// foreign key is written by hand in the migration, `ON DELETE SET NULL`, and
/// pinned by a drift probe in `lib/app/leaf-db-drift.ts`. `SET NULL` because the
/// history is about the document, not about the editor: erasing an admin removes
/// who made the edit, not the fact that the words changed.
///
/// An EXCLUSION in `lib/app/leaf-data-export.ts`. The reason given there says
/// that it keeps an administrator's account id and nothing else about them.
model AppFoundationalDocumentRevision {
  id                      String                   @id @default(cuid())
  documentSlug            String
  documentId              String
  document                AppFoundationalDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// The revision this produced. 1 is the seed.
  revision                Int
  /// The document as it stood at this revision.
  position                Int
  title                   String
  subtitle                String?
  category                String
  surface                 String
  requiresAcknowledgement Boolean
  placeholders            String[]
  renderStyle             String?
  renderNote              String?
  blocks                  Json
  version                 String
  locale                  String
  /// Which snapshot fields differ from the previous revision. At revision 1 that
  /// is every field. Never empty: a write that changes nothing makes no revision.
  changedFields           String[]
  origin                  AppContentRevisionOrigin
  /// The admin who made the edit. Null for the seed, and null once that admin's
  /// account is erased. Read `origin` to tell the two apart.
  editorId                String?
  changedAt               DateTime                 @default(now())

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([documentId, revision])
  @@index([orgId])
  /// The "document as it stood at time T" read.
  @@index([documentId, changedAt])
  @@index([editorId])
  @@map("app_foundational_document_revision")
}

// ============================================================================
// The journey's text, the discovery questions and the resource library
// (f-content-seeds t-87)
// ============================================================================
//
// The same pattern as her foundational documents above: one row per thing a
// surface shows, a full snapshot per revision from the first write, and every
// write through one service in `lib/app/content/`. Operator-owned (`fp4`): the
// seed writes each collection once and never again, so an admin edit (t-91)
// survives every later seed. None of these tables holds anything about a person;
// each is an EXCLUSION in `lib/app/leaf-data-export.ts`.

/// The journey as a whole: its title, subtitle, version and locale (t-87). One
/// row.
///
/// **What this and the two tables below own, and what they do not.** They own
/// the journey's TEXT: tier labels and intents, and module titles, subtitles and
/// phases. They do not own its STRUCTURE — which modules exist, their number and
/// the tier each sits in. That is the code roster in `lib/app/journey/roster.ts`,
/// from which the published map and the registered module definitions are built.
/// A module's title is therefore written in exactly one place, a row here, and
/// the registered `ModuleDefinition.name` is derived from it at startup. See
/// `lib/app/content/journey-store.ts`.
model AppJourney {
  id        String   @id @default(cuid())
  /// Stable identity, as authored: the app's name.
  slug      String
  title     String
  subtitle  String
  /// The authored version label, e.g. `1.0`.
  version   String
  /// BCP 47, as authored.
  locale    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tiers   AppJourneyTier[]
  modules AppJourneyModule[]

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("app_journey")
}

/// One tier's text: its label and what it is for (t-87). Which modules sit in
/// it, and its order, are the roster's.
model AppJourneyTier {
  id          String     @id @default(cuid())
  /// The tier id, e.g. `inner_authority`. Immutable: the roster keys on it.
  slug        String
  journeySlug String
  journeyId   String
  journey     AppJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  label       String
  intent      String
  /// Bumped on every write that changes something. 1 is the seed.
  revision    Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  revisions AppJourneyTierRevision[]

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("app_journey_tier")
}

/// One revision of one tier's text, whole (t-87). Same shape and reasoning as
/// `AppFoundationalDocumentRevision`, including the hand-written
/// `editorId → user ON DELETE SET NULL` foreign key and its drift probe.
model AppJourneyTierRevision {
  id            String                   @id @default(cuid())
  tierSlug      String
  tierId        String
  tier          AppJourneyTier           @relation(fields: [tierId], references: [id], onDelete: Cascade)
  revision      Int
  label         String
  intent        String
  /// Which snapshot fields differ from the previous revision. All of them at 1.
  changedFields String[]
  origin        AppContentRevisionOrigin
  /// Null for the seed, and null once that admin's account is erased.
  editorId      String?
  changedAt     DateTime                 @default(now())

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([tierId, revision])
  @@index([orgId])
  @@index([tierId, changedAt])
  @@index([editorId])
  @@map("app_journey_tier_revision")
}

/// One module's text (t-87): her title for it, its subtitle, and its phases.
///
/// **The one owner of a module's title.** The registered
/// `ModuleDefinition.name` is derived from this row at startup
/// (`lib/app/leaf-bootstrap.ts`), and the drawer, the module pages, the home
/// page and the content APIs read it here. Its number and tier are the
/// roster's; `displayNumber` is here because it is a label she wrote, not a
/// position.
///
/// `phases`, `phaseTiers` and `produces` are JSON validated on every write and
/// read (`lib/app/content/journey-view.ts`): every read takes a module whole,
/// and a snapshot of one row is then a snapshot of the module.
model AppJourneyModule {
  id            String     @id @default(cuid())
  /// The authored id, e.g. `module_01_values`. Immutable: the roster, the
  /// resource keys and the question set all name a module by it.
  slug          String
  journeySlug   String
  journeyId     String
  journey       AppJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  displayNumber String
  title         String
  subtitle      String?
  chartTitle    String?
  phases        Json
  phaseTiers    Json?
  produces      Json?
  revision      Int        @default(1)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  revisions    AppJourneyModuleRevision[]
  questionSets AppQuestionSet[]

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("app_journey_module")
}

/// One revision of one module's text, whole (t-87).
model AppJourneyModuleRevision {
  id            String                   @id @default(cuid())
  moduleSlug    String
  moduleId      String
  module        AppJourneyModule         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  revision      Int
  displayNumber String
  title         String
  subtitle      String?
  chartTitle    String?
  phases        Json
  phaseTiers    Json?
  produces      Json?
  changedFields String[]
  origin        AppContentRevisionOrigin
  editorId      String?
  changedAt     DateTime                 @default(now())

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([moduleId, revision])
  @@index([orgId])
  @@index([moduleId, changedAt])
  @@index([editorId])
  @@map("app_journey_module_revision")
}

/// A set of discovery questions and the words that frame it (t-87). There is
/// one, the onboarding module's thirty.
///
/// `preamble` (her note that these are not to be rushed) and `pacing` are JSON,
/// validated on every write and read.
model AppQuestionSet {
  id         String           @id @default(cuid())
  /// Stable identity, as authored: `onboarding_discovery_questions`.
