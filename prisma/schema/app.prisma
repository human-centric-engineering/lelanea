/// One global slot definition, as currently worded — what the app aims to learn
/// about a person (product description §5; f-slots t-70).
///
/// **This table is the authored taxonomy; `framework_slot_definition` is its
/// projection.** The provider registered from `lib/app/leaf-bootstrap.ts` reads
/// the active rows here and hands them to Daybreak's global slot sync, which
/// stamps `scope = global` (`lib/framework/data-slots/sync.ts`). Nothing writes
/// the framework row directly, and the framework row carries no history — the
/// version chain is here, because the editor is ours.
///
/// **`slug` is the primary key and is immutable.** It is the identity a captured
/// `framework_slot_value.slotSlug` points at, so renaming one would orphan every
/// answer already given under it. A rename is therefore an add plus a retire
/// (owner ruling, 19 September 2026), which is what `isActive` is for: a retired
/// row stays, the framework sync deactivates its projection, and the values
/// captured under it keep resolving to the wording they were captured under.
///
/// **No `scope` column, deliberately.** Every row here is global by construction
/// — the seam stamps the scope, so storing it would be a second copy that can
/// disagree with the only one that matters.
///
/// The classifier columns mirror `framework_slot_definition`'s as free-form
/// `String` rather than Prisma enums, for the framework's own reason (convention
/// X1): Daybreak adding a vocabulary value must not be a migration here. They
/// are validated on write and on read against
/// `lib/framework/data-slots/vocabulary.ts` — see `lib/app/slots/taxonomy-store.ts`.
///
/// Holds nothing about any person; an EXCLUSION in `lib/app/leaf-data-export.ts`.
model AppSlotDefinition {
  id             String   @id @default(cuid())
  /// Stable identity, immutable. Matches `framework_slot_value.slotSlug`.
  slug           String
  /// Thematic cluster — `life_areas`, `the_person`, `external_conditions`,
  /// `preferences`, `development`, or a module's own output.
  group          String
  /// What the slot means, in the words the capture agent is given.
  description    String
  /// `open` (the person sees and corrects it) or `hidden` (system-only).
  /// Development-stage slots are `hidden`: a tuning signal, never a grade (§12).
  visibility     String   @default("open")
  /// `targeted` (pre-declared) or `open` (minted at runtime).
  mode           String   @default("targeted")
  /// `text` | `number` | `boolean` | `date` | `json`.
  dataType       String   @default("text")
  /// `standard` | `sensitive` | `special_category`.
  sensitivity    String   @default("standard")
  /// Sequencing input for targeted capture; higher is asked sooner.
  priorityWeight Int      @default(0)
  /// False once retired. The row stays — see the docblock. A retired slug's
  /// projection is deactivated by the framework sync, not deleted.
  isActive       Boolean  @default(true)
  /// Bumped on every edit that changes a field. The revision below records the
  /// version it produced, so a value captured at time T resolves to the wording
  /// standing at T by comparing against `AppSlotDefinitionRevision.changedAt`.
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  revisions AppSlotDefinitionRevision[]

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, slug])
  @@index([orgId])
