// Fork-owned schema file — reserved for YOUR app's models.
//
// Sunrise ships this file empty and never adds models to it, the same way it
// keeps `lib/app/**` and `.context/app/` empty, so a fork's models here merge
// cleanly on every upstream sync. Sunrise's own app-domain models
// (ContactSubmission, FeatureFlag, AuthBootstrap) live in `platform.prisma`.
//
// The schema is multi-file (`prisma.config.ts` → `schema: 'prisma/schema'`), so
// every `.prisma` file in this folder is loaded — just add models below.
//
// See CUSTOMIZATION.md §5 for the FK/onDelete rules a model with a `userId`
// must follow (GDPR erasure depends on them).

/// Where a waitlist entry came from.
///
/// `form` is the public home page's card, and is the only value anything writes
/// today. `conversation` is reserved for the path the product description
/// describes — someone asking to be told when a place opens, in a conversation
/// with the agent — which has no code behind it yet. It is vocabulary rather
/// than a shipped write path, and it is here now because adding an enum value
/// later is a migration on a table that will by then hold real people.
enum AppWaitlistSource {
  form
  conversation

  @@map("app_waitlist_source")
}

/// Someone who asked to be told when a place opens.
///
/// The app is not open, so this is the only thing a visitor can actually do —
/// and what they said while doing it is the point, not a by-product. `intent`
/// ("what would you want to achieve") and `heardFrom` are read by Lelañea
/// herself while there are still few enough entries to read one by one, and
/// `intent` is meant to seed that person's profile if they later sign up, so
/// what someone said they wanted before signing up is not thrown away at the
/// point they do.
///
/// **`userId` is a plain scalar with no Prisma `@relation`** — a fork table must
/// not add a reverse field to the Sunrise-owned `User` model (CUSTOMIZATION.md
/// §5). The foreign key is hand-written in the `app_waitlist_entry` migration
/// with `ON DELETE SET NULL`, and pinned by a drift probe in
/// `lib/app/leaf-db-drift.ts` so a future `migrate dev` cannot quietly drop it.
///
/// `SET NULL` — not `Cascade` — because the row survives the account: the
/// waitlist is a record of who asked, and erasing an account should not silently
/// re-open a place. What it must NOT do is retain the person's email and their
/// answers, so the erasure hook registered from `lib/app/leaf-bootstrap.ts`
/// deletes the row outright inside the erasure transaction. The FK's `SET NULL`
/// is the backstop for a row the hook cannot match, not the policy.
model AppWaitlistEntry {
  id          String            @id @default(cuid())
  /// Lower-cased on write, which is what makes `@unique` mean one person.
  email       String            @unique
  name        String?
  /// "Where did you hear about this?" — optional (D2).
  heardFrom   String?
  /// "What would you want to achieve?" — optional (D2).
  intent      String?
  source      AppWaitlistSource @default(form)
  /// The language tag the joiner's browser asked for, so a later locale can
  /// tell who joined in which. Falls back to the authored collection's locale.
  locale      String
  /// When they submitted under the card's "used to tell you when a place opens,
  /// and for nothing else" notice. Server-set; there is no separate checkbox.
  consentedAt DateTime
  /// The account this entry became, once the person accepted an invitation.
  /// Written by the `user-created` hook in `lib/app/waitlist/service.ts`,
  /// matched on the lower-cased email, together with `joinedAt`. Hand-written
  /// FK — see the note above.
  userId      String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  /// When an admin took them off the list. Null means they are on it.
  ///
  /// **`removedAt`, not `deletedAt`, and the name is the point.** Nothing is
  /// deleted: the row survives holding this person's email, their name and what
  /// they said they wanted. Calling it a deletion is how a later reader concludes
  /// the Art. 17 duty was met by a click in the admin, which it was not — erasure
  /// still DELETES the row outright, through the hook registered from
  /// `lib/app/leaf-bootstrap.ts`, and the Art. 15 export still has to disclose a
  /// removed entry because we still hold it.
  removedAt         DateTime?
  /// When a removed address was last submitted through the public form again.
  ///
  /// A re-join does NOT put someone back on the list (D9, owner, 11 September
  /// 2026): nothing on that route proves the submitter owns the address, so
  /// clearing the removal would let anyone who knows an address undo someone
  /// else's removal. Recording the attempt is the middle path — the removal
  /// sticks, and a genuine "actually, please put me back" is visible to her
  /// rather than silently swallowed.
  rejoinRequestedAt DateTime?
  /// How many times a removed address has been submitted again. See above.
  rejoinRequests    Int       @default(0)
  /// When an admin last sent this person an invitation from the list. Moved on
  /// a resend — it records the latest send, and the CSV column is named for
  /// that. Null means nobody has invited them from here; an invitation raised
  /// from Sunrise's Admin → Users → Invite does not stamp it, and does not need
  /// to for `joinedAt` to land.
  invitedAt         DateTime?
  /// When the person accepted an invitation and got an account. Set with
  /// `userId`, by the hook. A joined entry is off the default list the way a
  /// removed one is, and for the opposite reason: not "will not be written
  /// to", but "already in". The two are different states — `removedAt` is left
  /// alone when someone joins — and the Art. 15 export discloses which.
  joinedAt          DateTime?

  @@index([userId])
  @@index([createdAt])
  /// NO index on `removedAt`, deliberately. The hot predicate is `removedAt IS
  /// NULL`, which matches nearly every row, so Postgres will sequentially scan
  /// whatever is indexed; the one selective form — `IS NOT NULL`, for the
  /// "show removed" view — wants a partial index, which Prisma's schema cannot
  /// express. An earlier version of this model carried `@@index([removedAt])` with
  /// a comment claiming the list "filters on this", which confuses reading the
  /// column with needing an index for it. Caught in review; the index was dropped
  /// before the migration shipped.
  @@map("app_waitlist_entry")
}

/// What a person can acknowledge at the gate — one value per thing the Terms
/// require before the app opens.
///
/// `disclaimer` and `terms` are the two foundational documents that carry
/// `requiresAcknowledgement: true` in the authored collection; `age_18` is the
/// eighteen-plus confirmation the Terms require, captured at the gate rather
/// than in Sunrise's signup form (A7) so no platform form is edited. The
/// mapping from a kind to its document id lives in `lib/app/gateway/`, and a
/// test pins that every acknowledgement-required document has a kind here.
enum AppAcknowledgementKind {
  disclaimer
  terms
  age_18

  @@map("app_acknowledgement_kind")
}

/// One thing a person acknowledged: which kind, against which version, when.
///
/// The gate in front of the shell reads this table (§06). A kind is satisfied
/// only by a row carrying the CURRENT version — the foundational collection's
/// version for the two documents, a constant for the age rule — so a change to
/// either document re-gates by construction, and the old row stays as the
/// record of what was agreed before. **Insert-only**: nothing updates or deletes
/// a row except erasure, which is why there is no `updatedAt`. The unique index
/// is what makes a repeat acknowledgement idempotent rather than a duplicate.
///
/// **`userId` is a plain scalar with no Prisma `@relation`** — a fork table must
/// not add a reverse field to the Sunrise-owned `User` model (CUSTOMIZATION.md
/// §5). The foreign key is hand-written in the `app_acknowledgement` migration
/// with `ON DELETE CASCADE` — this is personal data and goes when the account
/// goes — and pinned by a drift probe in `lib/app/leaf-db-drift.ts` so a future
/// `migrate dev` cannot quietly drop it. Declared in full as a subject-data
/// source in `lib/app/leaf-data-export.ts`.
model AppAcknowledgement {
  id              String                 @id @default(cuid())
  /// Hand-written FK — see the note above.
  userId          String
  kind            AppAcknowledgementKind
  /// The version this acknowledgement was given against: the foundational
  /// collection's `version` for `disclaimer` and `terms`, the constant the
  /// gateway module exports for `age_18`.
  documentVersion String
  /// Server-set at insert; the client never supplies it.
  acknowledgedAt  DateTime               @default(now())

  @@unique([userId, kind, documentVersion])
  @@index([userId])
  @@map("app_acknowledgement")
}

/// What one knowledge document is FOR, in the part that cannot be a tag.
///
/// Purpose and sensitivity are managed `KnowledgeTag` rows — that is what lets
/// them drive Sunrise's own tagging surfaces and its per-agent grant machinery.
/// The licensing note is free text about ONE document, and `KnowledgeTag` has no
/// per-document value column, so it has nowhere to live in the taxonomy without
/// minting a tag per note.
///
/// **And it cannot live in `AiKnowledgeDocument.metadata` either.** That column
/// is REPLACED wholesale by `lib/orchestration/knowledge/document-manager.ts` on
/// ingest, retry and re-chunk — a note an admin typed would disappear the first
/// time a document was re-processed, with no error and nothing in the log to
/// connect the loss to the cause. Hence a leaf table: `app_*`, ours, and outside
/// every write path the platform owns.
///
/// **`documentId` is a plain scalar with no Prisma `@relation`** — a fork table
/// must not add a reverse field to a Sunrise-owned model (CUSTOMIZATION.md §5),
/// and `AiKnowledgeDocument` lives in `prisma/schema/orchestration-knowledge.prisma`.
/// The foreign key is hand-written in the `app_knowledge_designation` migration
/// with `ON DELETE CASCADE` — the note is *about* the document and means nothing
/// without it — and pinned by a drift probe in `lib/app/leaf-db-drift.ts` so a
/// future `migrate dev` cannot quietly drop it.
///
/// Holds no personal data: every column is about a file she uploaded, not about
/// a person. Declared as an EXCLUSION with that reason in
/// `lib/app/leaf-data-export.ts`, which is what the Art. 15 bundle shows a data
/// subject verbatim.
///
/// The row is the document's designation, so `documentId` is the primary key:
/// one designation per document, and a re-designation is an update rather than a
/// second row. There is deliberately no history here — what a document is for is
/// current state, and the audit log already records who changed it.
model AppKnowledgeDesignation {
  /// Hand-written FK → `ai_knowledge_document`. See the note above.
  documentId   String   @id
  /// Free-text attribution / permission note: whose words these are, and on what
  /// terms we may use them. Null means nobody has said yet — which is different
  /// from "no restriction", and the admin surface says so.
  licensing    String?  @db.Text
  /// Who last set it, for the same reason the audit log exists. Deliberately NOT
  /// a relation and NOT a foreign key: it is an admin's id on an operational
  /// note, the row survives that admin's account, and a `user` FK here would
  /// make `eraseUser()` fail or silently rewrite the record of who designated
  /// what. Rendered as an id, resolved by the admin list when it can.
  designatedBy String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("app_knowledge_designation")
}
