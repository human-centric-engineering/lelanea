  title      String
  chartTitle String
  /// The module the set belongs to.
  moduleSlug String
  moduleId   String
  module     AppJourneyModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  /// The phase of that module it is asked in.
  phase      Int
  preamble   Json
  pacing     Json
  version    String
  locale     String
  revision   Int              @default(1)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  questions AppDiscoveryQuestion[]
  revisions AppQuestionSetRevision[]

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("app_question_set")
}

/// One revision of a question set's framing, whole (t-87).
model AppQuestionSetRevision {
  id            String                   @id @default(cuid())
  setSlug       String
  setId         String
  set           AppQuestionSet           @relation(fields: [setId], references: [id], onDelete: Cascade)
  revision      Int
  title         String
  chartTitle    String
  phase         Int
  preamble      Json
  pacing        Json
  version       String
  locale        String
  changedFields String[]
  origin        AppContentRevisionOrigin
  editorId      String?
  changedAt     DateTime                 @default(now())

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([setId, revision])
  @@index([orgId])
  @@index([setId, changedAt])
  @@index([editorId])
  @@map("app_question_set_revision")
}

/// One discovery question (t-87), recalled by its number within the set.
model AppDiscoveryQuestion {
  id                  String         @id @default(cuid())
  /// The authored id, e.g. `q01`.
  slug                String
  setSlug             String
  setId               String
  set                 AppQuestionSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  /// 1-based, and the order they are asked in.
  number              Int
  text                String
  /// `long_text`. Validated on write and read.
  inputType           String
  hint                String?
  /// `{ ifYes, ifNo }` where the question branches.
  conditionalFollowUp Json?
  /// How much the question matters, 0–100 (f-onboarding t-101). 100 is fully
  /// weighted, and the fully weighted questions are the Core Set.
  weight              Int            @default(100)
  revision            Int            @default(1)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  revisions AppDiscoveryQuestionRevision[]

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([setId, number])
  @@unique([orgId, slug])
  @@index([orgId])
  @@map("app_discovery_question")
}

/// One revision of one discovery question, whole (t-87).
model AppDiscoveryQuestionRevision {
  id                  String                   @id @default(cuid())
  questionSlug        String
  questionId          String
  question            AppDiscoveryQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  revision            Int
  number              Int
  text                String
  inputType           String
  hint                String?
  conditionalFollowUp Json?
  weight              Int                      @default(100)
  changedFields       String[]
  origin              AppContentRevisionOrigin
  editorId            String?
  changedAt           DateTime                 @default(now())

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([questionId, revision])
  @@index([orgId])
  @@index([questionId, changedAt])
  @@index([editorId])
  @@map("app_discovery_question_revision")
}

/// The resource library as a whole (t-87): its identity, and its provenance —
/// whether she has signed off what is in it. One row.
model AppResourceCollection {
  id         String   @id @default(cuid())
  /// Stable identity, as authored: `lelanea_resources`.
  slug       String
  title      String
  version    String
  locale     String
  /// `{ status, awaitingSignOffFrom, note }`, validated on write and read.
  /// Served, never withheld: a surface showing a resource can say it is a draft.
  provenance Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resources AppResource[]
  words     AppResourceWords[]

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("app_resource_collection")
}

/// One video, audio piece or article (t-87). One table because they are one
/// namespace: an id is what the suggestion tool and the drawer's pin resolve
/// by, and two kinds sharing one would always resolve to the same row.
///
/// A video or audio piece has `duration` and `href`. An article has
/// `readingTime` and exactly one of `href` and a document. These rules are
/// checked on every write and read (`lib/app/content/resource-view.ts`).
model AppResource {
  id             String                   @id @default(cuid())
  /// Lowercase with hyphens, at most 80 characters. Immutable: a suggestion
  /// already made in a conversation names it.
  slug           String
  collectionSlug String
  collectionId   String
  collection     AppResourceCollection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  /// `video` | `audio` | `article` (`RESOURCE_KINDS`).
  kind           String
  /// Order within its kind, which is the order the drawer offers them in.
  position       Int
  title          String
  /// What it is for, in her words.
  subtitle       String
  /// A module id, `journey`, `situations`, or null for a piece that belongs to
  /// everything.
  relatesTo      String?
  /// A video's or audio piece's length, as shown: `6:12`.
  duration       String?
  /// An article's reading time, as shown: `8 min`.
  readingTime    String?
  /// http(s) only.
  href           String?
  /// An article that is one of her foundational documents: its name here,
  /// and the document's generated id in `documentId` (t-113).
  documentSlug   String?
  documentId     String?
  document       AppFoundationalDocument? @relation(fields: [documentId], references: [id], onDelete: Restrict)
  /// Retired by an admin (t-91): no longer offered, listed or suggestable, but
  /// kept so a suggestion already made in a conversation still resolves to its
  /// chip. A resource is never deleted; retiring is the tombstone.
  retired        Boolean                  @default(false)
  revision       Int                      @default(1)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  revisions AppResourceRevision[]

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([collectionId, kind, position])
  @@unique([orgId, slug])
  @@index([orgId])
  @@map("app_resource")
}

/// One revision of one resource, whole (t-87).
model AppResourceRevision {
  id            String                   @id @default(cuid())
  resourceSlug  String
  resourceId    String
  resource      AppResource              @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  revision      Int
  kind          String
  position      Int
  title         String
  subtitle      String
  relatesTo     String?
  duration      String?
  readingTime   String?
  href          String?
  documentSlug  String?
  retired       Boolean                  @default(false)
  changedFields String[]
  origin        AppContentRevisionOrigin
  editorId      String?
  changedAt     DateTime                 @default(now())

  /// The org this row belongs to (Sunrise §107, t-112); the tenancy client stamps it.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([resourceId, revision])
  @@index([orgId])
  @@index([resourceId, changedAt])
  @@index([editorId])
  @@map("app_resource_revision")
}

/// Her words on one key (t-87): a quote and a few short paragraphs, each a
/// verbatim excerpt of a source this repository holds, citing it.
///
/// Keyed by a module id or `journey`, `situations`, `default`. A key with no
/// words of its own reads `default`'s, so `default` must exist.
