# Non-secret local development settings for THIS app.
#
# Unlike .env.local (ignored, holds secrets), this file is committed: it is how
# an app pins the port it binds so every clone agrees and `npm run dev` needs no
# arguments. Read by scripts/dev-server.mjs — see
# .context/environment/services-env.md#port
#
# Secrets belong in .env.local. Never add one here.

# Lelañea's loopback port, registered in the dev-proxy (~/Documents/Dev/dev-proxy,
# apps.json slug "lelanea"), which serves it as https://lelanea.test via Laravel
# Herd's nginx and trusted local CA.
#
# The port a fork binds is INDEPENDENT of the URL it is served on: this is the
# loopback port nginx forwards to, while BETTER_AUTH_URL and NEXT_PUBLIC_APP_URL
# in .env.local carry the proxied hostname. Changing this alone will not change
# the URL, and changing the URL alone will not change this — the dev-proxy
# registry is the third party that has to agree, so update apps.json too.
#
# See .context/app/local-dev.md.
PORT=3014
